---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classes, getClass, ageGroups } from '../../data/classes';
import { getMember } from '../../data/team';
import { getCourse } from '../../data/courses';

export async function getStaticPaths() {
  return classes.map((cls) => ({ params: { id: cls.id }, props: { cls } }));
}

const { cls } = Astro.props;
const head = getMember(cls.headTeacherId);
const group = ageGroups.find((g) => g.id === cls.ageGroupId);
---

<BaseLayout title={cls.name} description={`${cls.name} · 带班老师 ${head?.name ?? ''}`}>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <a href="/classes" class="text-sm text-grass-600 hover:underline">← 返回班级</a>

    <header class="mt-6 mb-10">
      {group && <span class="text-xs font-medium bg-grass-100 text-grass-700 px-2.5 py-1 rounded-full">{group.emoji} {group.label}</span>}
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">{cls.name}</h1>
    </header>

    <!-- 带班老师 -->
    <section class="mb-10">
      <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-grass-500 rounded-full"></span>带班老师
      </h2>
      {head ? (
        <a href={`/team/${head.id}`} class="group inline-flex items-center gap-4 bg-white rounded-3xl p-5 shadow-sm border border-grass-100 hover:shadow-lg transition-all">
          <span class="text-5xl">{head.avatar}</span>
          <div>
            <div class="font-bold text-gray-900 group-hover:text-grass-700 transition-colors">{head.name}</div>
            <div class="text-sm text-grass-600">{head.role}</div>
            <div class="text-sm text-gray-500 mt-1">{head.bio}</div>
          </div>
        </a>
      ) : (
        <p class="text-gray-400">带班老师待定。</p>
      )}
    </section>

    <!-- 课表 -->
    <section class="mb-10">
      <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-grass-500 rounded-full"></span>课表
        <span class="text-sm font-normal text-gray-400">(点击课程查看介绍 · 课件 · 视频)</span>
      </h2>
      <div class="bg-white rounded-3xl shadow-sm border border-grass-100 overflow-hidden divide-y divide-grass-50">
        {cls.timetable.map((entry) => {
          const course = getCourse(entry.courseId);
          const teacher = course ? getMember(course.teacherId) : undefined;
          return (
            <a href={course ? `/courses/${course.id}` : '#'} class="group flex items-center gap-4 px-5 py-4 hover:bg-grass-50 transition-colors">
              <span class="text-sm font-mono text-gray-500 w-32 shrink-0">{entry.time}</span>
              <span class="text-2xl">{course?.emoji ?? '📘'}</span>
              <div class="flex-1">
                <div class="font-medium text-gray-900 group-hover:text-grass-700 transition-colors">{course?.title ?? entry.courseId}</div>
                {teacher && <div class="text-xs text-gray-400">代课老师 · {teacher.name}</div>}
              </div>
              <span class="text-grass-400 group-hover:translate-x-1 transition-transform">→</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 班级学生 -->
    <section>
      <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-grass-500 rounded-full"></span>班级学生
        <span class="text-sm font-normal text-gray-400">共 {cls.students.length} 名</span>
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {cls.students.map((stu) => (
          <div class="bg-white rounded-2xl p-5 shadow-sm border border-grass-100">
            <div class="flex items-center gap-2 mb-3">
              <span class="w-9 h-9 rounded-full bg-grass-100 text-grass-700 flex items-center justify-center font-bold">{stu.name.slice(-1)}</span>
              <span class="font-bold text-gray-900">{stu.name}</span>
            </div>
            <dl class="text-sm space-y-2">
              <div>
                <dt class="text-gray-400 text-xs">性格特点</dt>
                <dd class={stu.personality ? 'text-gray-700' : 'text-gray-300 italic'}>
                  {stu.personality || '待带班老师填写'}
                </dd>
              </div>
              <div>
                <dt class="text-gray-400 text-xs">个性化辅导</dt>
                <dd class={stu.tutoring ? 'text-gray-700' : 'text-gray-300 italic'}>
                  {stu.tutoring || '待带班老师填写'}
                </dd>
              </div>
            </dl>
          </div>
        ))}
      </div>
      <p class="text-xs text-gray-400 mt-4">
        提示:学生性格与个性化辅导内容在 <code>src/data/classes.ts</code> 中由带班老师整理后填入。
      </p>
    </section>
  </div>
</BaseLayout>
