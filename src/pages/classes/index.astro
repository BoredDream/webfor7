---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ClassCard from '../../components/ClassCard.astro';
import { classes } from '../../data/classes';

const studentTotal = classes.reduce((sum, cls) => sum + cls.students.length, 0);
const courseTotal = classes.reduce((sum, cls) => sum + cls.timetable.length, 0);

const statItems = [
  { num: classes.length, label: '个班级', emoji: '🏫' },
  { num: studentTotal, label: '名学生', emoji: '🧒' },
  { num: courseTotal, label: '节课程', emoji: '📚' },
];
---

<BaseLayout title="班级">
  <PageHeader
    emoji="🏫"
    title="班级"
    hl="grass"
    subtitle="目前设置 3-6 岁和 6-12 岁两个班级,每个班对应不同的学习节奏、课程安排和带班老师。点击班级即可查看一日课表与学生档案。"
  />

  <div class="mx-auto max-w-6xl px-4 py-12 md:py-14">
    <!-- 数据条 -->
    <div class="mb-12 flex flex-wrap items-stretch justify-center gap-5">
      <div class="grid w-full max-w-2xl grid-cols-3 gap-5">
        {statItems.map((s) => (
          <div class="sticker-card p-5 text-center md:p-6">
            <div class="text-3xl">{s.emoji}</div>
            <p class="mt-2 font-display text-4xl font-bold leading-none text-ink">{s.num}</p>
            <p class="mt-1.5 text-sm font-bold text-ink/45">{s.label}</p>
          </div>
        ))}
      </div>
      <a href="/timetable" class="sticker-card group flex w-full max-w-xs items-center justify-center gap-4 bg-sun-400 px-8 py-5 sm:w-auto" style="border-color:transparent">
        <span class="text-3xl">📅</span>
        <span>
          <span class="block font-display text-xl font-bold leading-tight text-ink">查看完整课表</span>
          <span class="inline-block text-sm font-bold text-ink/60 transition-transform group-hover:translate-x-0.5">两周营期安排 →</span>
        </span>
      </a>
    </div>

    <SectionTitle title="选择班级" emoji="🎒" desc="点击进入查看带班老师、一日课表和学生档案整理进度。" />

    <div class="mt-7 grid gap-7 md:grid-cols-2">
      {classes.map((cls) => (
        <ClassCard cls={cls} />
      ))}
    </div>
  </div>
</BaseLayout>
