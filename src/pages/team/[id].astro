---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { members, getMember } from '../../data/team';
import { courses } from '../../data/courses';
import { classes } from '../../data/classes';

export async function getStaticPaths() {
  return members.map((member) => ({ params: { id: member.id }, props: { member } }));
}

const { member } = Astro.props;
const teaches = courses.filter((c) => c.teacherId === member.id);
const heads = classes.filter((c) => c.headTeacherId === member.id);
---

<BaseLayout title={member.name} description={member.bio}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <a href="/team" class="text-sm text-grass-600 hover:underline">← 返回人员</a>

    <header class="mt-6 mb-8 flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
      <div class="w-28 h-28 rounded-full bg-gradient-to-br from-grass-100 to-sky-100 flex items-center justify-center shrink-0">
        {member.avatar.startsWith('/') || member.avatar.startsWith('http') ? (
          <img src={member.avatar} alt={member.name} class="w-full h-full rounded-full object-cover" />
        ) : (
          <span class="text-6xl">{member.avatar}</span>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{member.name}</h1>
        <p class="text-grass-600 font-medium mt-1">{member.role}</p>
        {member.subjects && (
          <div class="flex flex-wrap gap-2 mt-3 justify-center sm:justify-start">
            {member.subjects.map((s) => (
              <span class="text-xs bg-grass-50 text-grass-700 px-2.5 py-1 rounded-full">{s}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <section class="bg-white rounded-3xl p-6 shadow-sm border border-grass-100 space-y-3 text-gray-700 leading-relaxed">
      {member.intro.map((p) => <p>{p}</p>)}
    </section>

    {(teaches.length > 0 || heads.length > 0) && (
      <section class="grid sm:grid-cols-2 gap-6 mt-6">
        {teaches.length > 0 && (
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-grass-100">
            <h2 class="text-sm font-semibold text-gray-400 mb-3">任教课程</h2>
            <ul class="space-y-2">
              {teaches.map((c) => (
                <li>
                  <a href={`/courses/${c.id}`} class="text-grass-700 hover:underline">{c.emoji} {c.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {heads.length > 0 && (
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-grass-100">
            <h2 class="text-sm font-semibold text-gray-400 mb-3">带班</h2>
            <ul class="space-y-2">
              {heads.map((c) => (
                <li>
                  <a href={`/classes/${c.id}`} class="text-grass-700 hover:underline">🏫 {c.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}
  </div>
</BaseLayout>
