---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportRow from '../components/ReportRow.astro';
import Counter from '../components/Counter.astro';
import { site, stats } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];

// 口号按逗号断行,第一段加黄色高亮块
const sloganParts = site.slogan.split(/[,,]/).filter(Boolean);

// 数据区:受益学生为主卡(featured),其余为小卡
const mainStat = stats.find((s) => s.label === '受益学生') ?? stats[0];
const sideStats = stats.filter((s) => s !== mainStat);
---

<BaseLayout title="报道">
  <!-- Hero(仿 index.html) -->
  <section class="hero">
    <!-- 装饰云 -->
    <span class="deco-cloud" style="top:14%;right:8%;">☁️</span>
    <span class="deco-cloud" style="top:24%;right:24%;font-size:22px;animation-delay:-6s;">☁️</span>

    <div class="mx-auto max-w-6xl px-4 hero-inner">
      <div class="hero-tag"><span class="dot"></span>{site.org} · {site.year}</div>
      <h1 class="hero-title">
        {sloganParts.map((part, i) => (
          <>
            {i === 0 ? <span class="highlight">{part}</span> : part}
            {i < sloganParts.length - 1 && <>,<br /></>}
          </>
        ))}
      </h1>
      <p class="hero-subtitle">✦ 大学生支教 · 陪伴乡村孩子看见更大的世界 ✦</p>
      <p class="hero-desc">{site.description}</p>
      <div class="hero-buttons">
        <a href="/courses" class="hbtn hbtn-primary">看看我们的课程 <span>→</span></a>
        <a href="/timetable" class="hbtn hbtn-outline">查看课表 <span>→</span></a>
        <a href="/classes" class="hbtn hbtn-outline">走进班级 <span>→</span></a>
      </div>

      <!-- 数据卡 -->
      <div class="stats-row">
        <div class="stat-card featured">
          <span class="stat-tape"></span>
          <div class="stat-label">{mainStat.label}</div>
          <div class="stat-number"><Counter value={mainStat.value} /><span class="unit">{mainStat.suffix}</span></div>
          <div class="stat-note">每一个数字背后,都是一段真实发生的相遇。</div>
        </div>
        {sideStats.map((s) => (
          <div class="stat-card">
            <div class="stat-label">{s.label}</div>
            <div class="stat-number"><Counter value={s.value} /><span class="unit">{s.suffix}</span></div>
            {s.href ? <a href={s.href} class="stat-link">查看课表 →</a> : <div class="stat-spacer"></div>}
          </div>
        ))}
        <a href="/team" class="stat-card stat-team">
          <div class="stat-label">✦</div>
          <div class="stat-number stat-symbol">→</div>
          <span class="stat-link">认识把光带过去的人 →</span>
        </a>
      </div>
    </div>

    <!-- 山峦 -->
    <div class="hero-mountains">
      <div class="mountain-back">
        <span class="mtree" style="left:22%;font-size:16px;">🌲</span>
        <span class="mtree" style="left:50%;font-size:11px;">🌳</span>
        <span class="mtree" style="left:76%;font-size:14px;">🌲</span>
      </div>
      <div class="mountain-front">
        <span class="mtree" style="left:18%;font-size:10px;">🌿</span>
        <span class="mtree" style="left:62%;font-size:12px;">🍃</span>
      </div>
    </div>

    <div class="scroll-ind"><div class="mouse"></div>向下探索</div>
  </section>

  <!-- 营地报道(标题放大) -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="text-center">
      <span class="inline-flex items-center gap-2 text-sm font-bold tracking-widest text-grass-600">📌 营地动态</span>
      <h2 class="mt-3 font-display text-4xl font-bold text-ink md:text-5xl">
        <span class="hl-sun">营地报道</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink/55">支教路上的故事、教学日记与项目公告 —— 点击分类筛选,翻开每一段真实的相遇。</p>
    </div>

    {allTags.length > 0 && (
      <div class="mt-9 flex flex-wrap justify-center gap-2.5" id="tagFilter">
        <button data-tag="all" class="tag-btn active sticker-pill bg-sun-400 text-ink text-sm font-bold cursor-pointer">全部</button>
        {allTags.map((t) => (
          <button data-tag={t} class="tag-btn sticker-pill bg-card text-ink/60 text-sm font-bold cursor-pointer">#{t}</button>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <p class="text-ink/50 text-center py-12">还没有文章。在 <code>src/content/blog/</code> 里新增 .md 文件即可。</p>
    ) : (
      <div id="articleGrid" class="mt-10 grid gap-6">
        {posts.map((post) => (
          <div class="article-item" data-tags={post.data.tags.join(',')}>
            <ReportRow post={post} />
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: 40px 0 116px; }
  @media (min-width: 768px) { .hero { min-height: 86vh; display: flex; align-items: center; padding: 0 0 150px; } }
  .hero-inner { position: relative; z-index: 2; width: 100%; }

  .hero-tag { display: inline-flex; align-items: center; gap: 9px; background: #fff; border: 1.5px solid #ececec; padding: 7px 18px; border-radius: 999px; font-size: 12px; color: #8b7e6a; margin-bottom: 22px; box-shadow: 0 2px 8px rgba(180,160,120,.08); letter-spacing: .5px; font-weight: 600; }
  .hero-tag .dot { width: 8px; height: 8px; background: #ffc107; border-radius: 50%; box-shadow: 0 0 8px rgba(255,200,61,.5); animation: hblink 2.5s ease-in-out infinite; }
  @keyframes hblink { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .25; transform: scale(.7); } }

  .hero-title { font-family: var(--font-display); font-weight: 800; line-height: 1.34; letter-spacing: 1px; color: #2c2c2c; font-size: 34px; margin-bottom: 18px; }
  @media (min-width: 768px) { .hero-title { font-size: 54px; } }
  .hero-title .highlight { display: inline-block; background: linear-gradient(135deg,#ffd24d,#f5a623); color: #3a2c14; padding: 2px 16px; border-radius: 10px; transform: rotate(-1.5deg); box-shadow: 4px 4px 0 rgba(255,200,61,.25); }

  .hero-subtitle { font-size: 14px; color: #9a8e7a; margin-bottom: 14px; letter-spacing: 1px; font-weight: 500; }
  .hero-desc { font-size: 15.5px; color: #6b6560; line-height: 1.9; margin-bottom: 28px; max-width: 500px; }
  .hero-buttons { display: flex; gap: 12px; flex-wrap: wrap; }

  .hbtn { display: inline-flex; align-items: center; gap: 7px; padding: 12px 26px; border-radius: 999px; font-size: 14px; font-weight: 700; text-decoration: none; letter-spacing: .3px; transition: transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s, border-color .3s; }
  .hbtn span { transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
  .hbtn:hover span { transform: translateX(4px); }
  .hbtn-primary { background: linear-gradient(135deg,#ffd24d,#ffc107); color: #2c2c2c; box-shadow: 0 6px 18px rgba(245,163,29,.22); }
  .hbtn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(245,163,29,.32); }
  .hbtn-outline { background: #fff; color: #2c2c2c; border: 1.5px solid #ececec; box-shadow: 0 3px 10px rgba(180,160,120,.08); }
  .hbtn-outline:hover { transform: translateY(-3px); border-color: #ffd24d; }

  .stats-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 42px; }
  @media (min-width: 900px) { .stats-row { grid-template-columns: 2fr 1fr 1fr 1fr 1fr; } }
  .stat-card { position: relative; background: #fff; border-radius: 18px; padding: 20px; border: 1.5px solid #ececec; box-shadow: 0 4px 14px rgba(180,160,120,.07); min-height: 150px; display: flex; flex-direction: column; justify-content: space-between; transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .4s; }
  .stat-card:hover { transform: translateY(-6px); box-shadow: 0 14px 30px rgba(180,160,120,.14); }
  .stat-card.featured { grid-column: span 2; border-top: 3px solid #ffc83d; padding: 26px 28px; }
  @media (min-width: 900px) { .stat-card.featured { grid-column: span 1; } }
  .stat-tape { position: absolute; top: -8px; left: 50%; width: 56px; height: 14px; margin-left: -28px; transform: rotate(-3deg); border-radius: 2px; background: repeating-linear-gradient(45deg, rgba(255,200,61,.7), rgba(255,200,61,.7) 3px, rgba(255,230,150,.5) 3px, rgba(255,230,150,.5) 6px); }
  .stat-label { font-size: 11px; color: #a09a94; font-weight: 800; letter-spacing: 2px; margin-bottom: 6px; }
  .stat-number { font-family: var(--font-display); font-weight: 900; line-height: .98; font-size: 46px; background: linear-gradient(135deg,#2c2c2c 0%,#f5a623 52%,#ffc107 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .stat-card.featured .stat-number { font-size: 56px; }
  .stat-number .unit { font-size: 15px; font-weight: 700; margin-left: 4px; }
  .stat-note { font-size: 13px; color: #8b7e6a; margin-top: 10px; line-height: 1.7; }
  .stat-link { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; color: #c67a2e; text-decoration: none; font-weight: 700; margin-top: 8px; transition: gap .25s; }
  .stat-link:hover { gap: 8px; }
  .stat-spacer { height: 22px; }
  .stat-symbol { font-size: 40px; }
  .stat-team { cursor: pointer; }

  .hero-mountains { position: absolute; bottom: 0; left: 0; right: 0; height: 200px; pointer-events: none; z-index: 0; }
  .mountain-back { position: absolute; bottom: 0; left: -5%; right: -5%; height: 190px; background: linear-gradient(180deg,#cfe3a8,#b6d68f); border-radius: 50% 60% 0 0 / 100% 100% 0 0; opacity: .45; }
  .mountain-front { position: absolute; bottom: 0; left: 8%; right: -8%; height: 128px; background: linear-gradient(180deg,#dcebac,#c2dd92); border-radius: 60% 40% 0 0 / 100% 100% 0 0; opacity: .55; }
  .mtree { position: absolute; bottom: 100%; opacity: .5; }

  .deco-cloud { position: absolute; opacity: .35; font-size: 30px; animation: hcloud 16s ease-in-out infinite; z-index: 1; }
  @keyframes hcloud { 0%,100% { transform: translateX(0); } 50% { transform: translateX(20px); } }

  .scroll-ind { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 2; text-align: center; color: #b6ada0; font-size: 10px; letter-spacing: 3px; font-weight: 600; }
  .scroll-ind .mouse { display: block; width: 16px; height: 24px; border: 1.5px solid #c9c0b3; border-radius: 8px; position: relative; margin: 0 auto 5px; }
  .scroll-ind .mouse::after { content: ''; position: absolute; top: 5px; left: 50%; transform: translateX(-50%); width: 2px; height: 5px; background: #c9c0b3; border-radius: 1px; animation: sdot 1.8s ease-in-out infinite; }
  @keyframes sdot { 0% { opacity: 1; top: 5px; } 50% { opacity: .3; top: 12px; } 100% { opacity: 1; top: 5px; } }

  @media (prefers-reduced-motion: reduce) {
    .hero-tag .dot, .deco-cloud, .scroll-ind .mouse::after { animation: none; }
  }
</style>

<script>
  // 分类索引:按标签筛选营地报道
  const setupFilter = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
    const items = document.querySelectorAll<HTMLElement>('.article-item');
    if (buttons.length === 0) return;
    const setActive = (btn: Element) => {
      buttons.forEach((b) => {
        b.classList.remove('active', 'bg-sun-400', 'text-ink');
        b.classList.add('bg-card', 'text-ink/60');
      });
      btn.classList.add('active', 'bg-sun-400', 'text-ink');
      btn.classList.remove('bg-card', 'text-ink/60');
    };
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag!;
        setActive(btn);
        items.forEach((item) => {
          const tags = (item.dataset.tags || '').split(',');
          item.style.display = tag === 'all' || tags.includes(tag) ? '' : 'none';
        });
      });
    });
  };
  setupFilter();
  document.addEventListener('astro:page-load', setupFilter);
</script>
