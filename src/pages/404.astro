---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面走丢了">
  <div class="mx-auto max-w-xl px-4 py-28 text-center">
    <div class="text-7xl mb-6">🧭</div>
    <h1 class="text-3xl font-bold text-gray-900">页面走丢了</h1>
    <p class="text-gray-500 mt-3">你访问的页面不存在,也许它去支教了。</p>
    <a href="/" class="inline-block mt-8 bg-grass-600 text-white font-semibold px-6 py-3 rounded-full hover:bg-grass-700 transition-colors">
      返回首页
    </a>
  </div>
</BaseLayout>
