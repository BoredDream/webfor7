---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/decor/Doodle.astro';
---

<BaseLayout title="页面走丢了">
  <div class="relative mx-auto max-w-xl px-4 py-28 text-center">
    <Doodle variant="cloud" class="absolute left-[8%] top-12 w-20 opacity-70" />
    <Doodle variant="sparkle" class="absolute right-[14%] top-24 w-8" />
    <div class="text-7xl mb-6">🧭</div>
    <h1 class="font-display text-3xl md:text-4xl text-ink"><span class="hl-sun">页面走丢了</span></h1>
    <p class="text-ink/60 font-medium mt-4">你访问的页面不存在,也许它去支教了。</p>
    <a href="/" class="sticker-btn bg-sun-400 inline-block mt-9">回到首页</a>
  </div>
</BaseLayout>
