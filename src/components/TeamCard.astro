---
import type { Member } from '../data/team';
interface Props { member: Member; href?: string }
const { member, href = `/team/${member.id}` } = Astro.props;
const isImage = member.avatar.startsWith('/') || member.avatar.startsWith('http');
---

<a
  href={href}
  class="group block bg-white rounded-3xl p-6 text-center shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all border border-grass-100"
>
  <div class="mx-auto mb-4 w-20 h-20 rounded-full bg-gradient-to-br from-grass-100 to-sky-100 flex items-center justify-center overflow-hidden">
    {isImage ? (
      <img src={member.avatar} alt={member.name} class="w-full h-full object-cover" />
    ) : (
      <span class="text-4xl group-hover:scale-110 transition-transform">{member.avatar}</span>
    )}
  </div>
  <h3 class="font-bold text-gray-900 group-hover:text-grass-700 transition-colors">{member.name}</h3>
  <p class="text-sm text-grass-600 font-medium mt-0.5">{member.role}</p>
  {member.bio && <p class="text-sm text-gray-500 mt-2 leading-relaxed">{member.bio}</p>}
</a>
