---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, date, summary, cover, tags, author } = post.data;
const dateStr = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

// 无封面时按标题生成一个柔和渐变占位
const gradients = [
  'from-grass-200 to-sky-200',
  'from-sky-200 to-amber-100',
  'from-amber-100 to-pink-200',
  'from-pink-200 to-grass-200',
];
const g = gradients[title.length % gradients.length];
---

<a
  href={`/blog/${post.id}`}
  class="group flex flex-col bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all border border-grass-100"
>
  <div class="aspect-[16/9] overflow-hidden">
    {cover ? (
      <img src={cover} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
    ) : (
      <div class={`w-full h-full bg-gradient-to-br ${g} flex items-center justify-center`}>
        <span class="text-5xl opacity-80">📰</span>
      </div>
    )}
  </div>
  <div class="flex flex-col flex-1 p-6">
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.map((t) => (
        <span class="text-xs bg-grass-50 text-grass-700 px-2.5 py-1 rounded-full">#{t}</span>
      ))}
    </div>
    <h3 class="text-lg font-bold text-gray-900 group-hover:text-grass-700 transition-colors leading-snug">
      {title}
    </h3>
    <p class="text-sm text-gray-600 mt-2 leading-relaxed line-clamp-3 flex-1">{summary}</p>
    <div class="flex items-center justify-between mt-4 text-xs text-gray-400">
      <span>{author ?? ''}</span>
      <time datetime={date.toISOString()}>{dateStr}</time>
    </div>
  </div>
</a>
