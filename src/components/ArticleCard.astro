---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; class?: string }
const { post, class: cls = '' } = Astro.props;
const { title, date, summary, cover, tags, author } = post.data;
const dateStr = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

// 无封面时按标题循环一组蜡笔色占位
const placeholders = [
  { bg: 'bg-csky-100', emoji: '📰' },
  { bg: 'bg-camber-100', emoji: '🖍️' },
  { bg: 'bg-cpink-100', emoji: '📮' },
  { bg: 'bg-cgrass-100', emoji: '🌱' },
];
const ph = placeholders[title.length % placeholders.length];
---

<a href={`/blog/${post.id}`} class={`sticker-card group flex flex-col overflow-hidden ${cls}`}>
  <div class="aspect-[16/9] overflow-hidden border-b-2 border-ink/15">
    {cover ? (
      <img src={cover} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
    ) : (
      <div class={`w-full h-full ${ph.bg} grid place-items-center`}>
        <span class="text-5xl transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">{ph.emoji}</span>
      </div>
    )}
  </div>
  <div class="flex flex-col flex-1 p-6">
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.map((t) => (
        <span class="rounded-full border-2 border-ink/15 bg-card px-2.5 py-0.5 text-xs font-bold text-ink/70">#{t}</span>
      ))}
    </div>
    <h3 class="font-display text-xl text-ink leading-snug">{title}</h3>
    <p class="text-sm text-ink/65 font-medium mt-2 leading-relaxed line-clamp-3 flex-1">{summary}</p>
    <div class="flex items-center justify-between mt-4 text-xs font-bold text-ink/45">
      <span>{author ? `✏️ ${author}` : ''}</span>
      <time datetime={date.toISOString()}>{dateStr}</time>
    </div>
  </div>
</a>
