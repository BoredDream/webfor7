---
import Doodle from './decor/Doodle.astro';

interface Props {
  title: string;
  subtitle?: string;
  emoji?: string;
  /** 标题高亮笔触颜色 */
  hl?: 'sun' | 'grass' | 'sky' | 'pink';
}
const { title, subtitle, emoji, hl = 'sun' } = Astro.props;
---

<section class="relative overflow-hidden border-b-2 border-dashed border-ink/15">
  <Doodle variant="sun" class="absolute right-[5%] top-6 w-16 md:w-20 opacity-90" />
  <Doodle variant="cloud" class="absolute left-[4%] top-10 w-16 opacity-70" />
  <div class="relative mx-auto max-w-6xl px-4 py-12 md:py-16 text-center float-in">
    {emoji && <div class="text-5xl mb-3">{emoji}</div>}
    <h1 class="font-display text-3xl md:text-4xl text-ink">
      <span class={`hl-${hl}`}>{title}</span>
    </h1>
    {subtitle && <p class="mt-4 text-ink/65 font-medium max-w-2xl mx-auto leading-relaxed">{subtitle}</p>}
  </div>
</section>
