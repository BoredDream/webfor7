---
import type { Course } from '../data/courses';
import { getMember } from '../data/team';
import { catColor } from './categoryColors';

interface Props {
  course: Course;
  /** featured:横向大卡(bento 首卡);normal:标准卡 */
  size?: 'featured' | 'normal';
  class?: string;
}
const { course, size = 'normal', class: cls = '' } = Astro.props;
const color = catColor[course.category];
const teacher = getMember(course.teacherId);
---

{size === 'featured' ? (
  <a href={`/courses/${course.id}`} class={`sticker-card group grid overflow-hidden sm:grid-cols-5 ${cls}`}>
    <div class={`relative grid min-h-48 place-items-center sm:col-span-2 ${color.soft}`}>
      <span class="grid h-20 w-20 place-items-center rounded-2xl bg-white text-5xl shadow-[0_6px_18px_rgba(120,110,90,0.12)] transition-transform duration-300 group-hover:-translate-y-1">{course.emoji}</span>
      <span class={`absolute right-4 top-4 rounded-full px-2.5 py-1 text-xs font-bold ${color.chip}`}>{course.category}类</span>
    </div>
    <div class="flex flex-col p-7 sm:col-span-3">
      <h3 class="font-display text-[1.7rem] leading-tight text-ink">{course.title}</h3>
      <p class="mt-1 text-sm font-semibold text-ink/45">面向 {course.audience}{teacher && ` · ${teacher.name} 老师`}</p>
      <p class="mt-3.5 leading-relaxed text-ink/65">{course.intro[0]}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {course.highlights.map((h) => (
          <span class="rounded-full bg-gray-50 px-2.5 py-1 text-xs font-semibold text-ink/55">{h}</span>
        ))}
      </div>
      <span class={`mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold ${color.text} transition-all group-hover:gap-2`}>
        查看课程详情 →
      </span>
    </div>
  </a>
) : (
  <a href={`/courses/${course.id}`} class={`sticker-card group flex flex-col overflow-hidden ${cls}`}>
    <div class={`flex items-center gap-3.5 px-5 py-4 ${color.soft}`}>
      <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-white text-2xl shadow-[0_4px_12px_rgba(120,110,90,0.12)]">{course.emoji}</span>
      <div class="min-w-0">
        <span class={`text-[0.7rem] font-bold tracking-wider ${color.text}`}>{course.category}类</span>
        <h3 class="font-display text-lg leading-tight text-ink">{course.title}</h3>
      </div>
    </div>
    <div class="flex flex-1 flex-col p-5">
      <p class="text-xs font-semibold text-ink/40">面向 {course.audience}{teacher && ` · ${teacher.name} 老师`}</p>
      <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink/65">{course.goal}</p>
      <div class="mt-3.5 flex flex-wrap gap-1.5">
        {course.highlights.slice(0, 2).map((h) => (
          <span class="rounded-full bg-gray-50 px-2.5 py-1 text-xs font-semibold text-ink/55">{h}</span>
        ))}
      </div>
      <span class={`mt-4 inline-flex items-center gap-1 text-sm font-bold ${color.text} transition-all group-hover:gap-2`}>
        查看详情 →
      </span>
    </div>
  </a>
)}
