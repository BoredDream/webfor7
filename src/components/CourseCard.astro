---
import type { Course } from '../data/courses';
import { getMember } from '../data/team';
import { catColor } from './categoryColors';

interface Props {
  course: Course;
  /** featured:横向大卡(bento 首卡);normal:标准卡 */
  size?: 'featured' | 'normal';
  class?: string;
}
const { course, size = 'normal', class: cls = '' } = Astro.props;
const color = catColor[course.category];
const teacher = getMember(course.teacherId);
---

{size === 'featured' ? (
  <a href={`/courses/${course.id}`} class={`sticker-card group grid sm:grid-cols-5 overflow-hidden h-full ${cls}`}>
    <span class="tape" aria-hidden="true"></span>
    <div class={`sm:col-span-2 relative min-h-44 grid place-items-center border-b-2 sm:border-b-0 sm:border-r-2 border-ink/15 ${color.soft}`}>
      <span class="text-7xl transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">{course.emoji}</span>
      <span class={`absolute right-3 top-3 rounded-full px-2.5 py-1 text-xs font-bold ${color.chip}`}>{course.category}类</span>
    </div>
    <div class="sm:col-span-3 p-7 flex flex-col">
      <h3 class="font-display text-2xl text-ink">{course.title}</h3>
      <p class="text-sm font-bold text-ink/50 mt-0.5">面向 {course.audience}{teacher && ` · ${teacher.name} 老师`}</p>
      <p class="mt-3 text-sm text-ink/65 leading-relaxed font-medium">{course.intro[0]}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {course.highlights.map((h) => (
          <span class="rounded-full border-2 border-ink/10 px-2.5 py-1 text-xs font-bold text-ink/60">{h}</span>
        ))}
      </div>
      <span class="mt-auto pt-4 inline-flex items-center gap-1 text-sm font-bold text-ink/55 group-hover:gap-2 transition-all">
        查看课程详情 →
      </span>
    </div>
  </a>
) : (
  <a href={`/courses/${course.id}`} class={`sticker-card group flex flex-col overflow-hidden h-full ${cls}`}>
    <div class={`relative h-24 grid place-items-center border-b-2 border-ink/15 ${color.soft}`}>
      <span class="text-5xl transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">{course.emoji}</span>
      <span class={`absolute right-3 top-3 rounded-full px-2.5 py-1 text-xs font-bold ${color.chip}`}>{course.category}类</span>
    </div>
    <div class="p-6 flex flex-col flex-1">
      <h3 class="font-display text-xl text-ink">{course.title}</h3>
      <p class="text-sm font-bold text-ink/50 mt-0.5">面向 {course.audience}</p>
      <p class="mt-2.5 text-sm text-ink/65 leading-relaxed font-medium flex-1">{course.goal}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {course.highlights.slice(0, 2).map((h) => (
          <span class="rounded-full border-2 border-ink/10 px-2.5 py-1 text-xs font-bold text-ink/60">{h}</span>
        ))}
      </div>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-ink/55 group-hover:gap-2 transition-all">
        查看课程详情 →
      </span>
    </div>
  </a>
)}
