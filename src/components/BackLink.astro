---
// 智能返回链接:站内导航深度 > 1 时 history.back()(可回到来源页,如从班级页点进课程
// 后能返回原班级);否则(直达 / 新标签打开)走 fallback 列表页。
// 与 ClientRouter 兼容:深度计数挂在 astro:page-load,原生后退由 popstate 修正。
interface Props {
  /** 无历史可退时的兜底路径,如 /classes */
  fallback: string;
  label: string;
}
const { fallback, label } = Astro.props;
---

<a
  href={fallback}
  data-backlink
  class="inline-flex items-center gap-1.5 text-sm font-bold text-ink/55 hover:text-ink transition-colors"
>
  <span aria-hidden="true">←</span>
  {label}
</a>

<script>
  // 模块脚本只执行一次(跨视图过渡持续存活),因此用事件委托 + 全局监听。
  const KEY = 'nav:depth';
  const get = () => parseInt(sessionStorage.getItem(KEY) || '0', 10);
  const set = (v: number) => sessionStorage.setItem(KEY, String(Math.max(0, v)));

  // 刷新 / 浏览器前进后退进入页面时,首次 page-load 不增加深度
  const navEntry = performance.getEntriesByType('navigation')[0] as
    | PerformanceNavigationTiming
    | undefined;
  let skipFirst = navEntry?.type === 'reload' || navEntry?.type === 'back_forward';

  document.addEventListener('astro:page-load', () => {
    if (skipFirst) {
      skipFirst = false;
      return;
    }
    set(get() + 1);
  });

  // 原生后退/前进:随后到来的 astro:page-load 会 +1,这里 -2 使净效果为 -1
  window.addEventListener('popstate', () => set(get() - 2));

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const link = target?.closest?.('[data-backlink]');
    if (!link) return;
    if (get() > 1) {
      e.preventDefault();
      history.back();
    }
    // 深度不足时不拦截,走 href 的 fallback 正常导航
  });
</script>
