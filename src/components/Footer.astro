---
import { site, nav } from '../data/site';
import Hills from './decor/Hills.astro';
---

<footer class="mt-24">
  <Hills />
  <div class="bg-ink text-paper/85 -mt-px">
    <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2 font-display text-xl mb-3 text-sun-300">
          <span class="text-2xl">☀️</span>{site.name}
        </div>
        <p class="text-paper/70 text-sm leading-relaxed max-w-xs">{site.description}</p>
      </div>

      <div>
        <h3 class="font-display text-lg mb-3 text-sun-300">页面导航</h3>
        <ul class="space-y-2 text-sm text-paper/70">
          {nav.map((item) => (
            <li><a href={item.href} class="hover:text-sun-300 transition-colors">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-lg mb-3 text-sun-300">联系我们</h3>
        <p class="text-sm text-paper/70">{site.org}</p>
        <p class="text-sm text-paper/70 mt-1">邮箱:{site.email}</p>
      </div>
    </div>

    <div class="border-t border-paper/15">
      <div class="mx-auto max-w-6xl px-4 py-4 text-xs text-paper/50 text-center">
        © {site.year} {site.org} · 用 ❤️ 与代码搭建
      </div>
    </div>
  </div>
</footer>
