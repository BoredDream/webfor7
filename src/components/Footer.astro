---
import { site, nav } from '../data/site';
---

<footer class="mt-24 bg-grass-700 text-grass-50">
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 font-bold text-lg mb-3">
        <span class="text-2xl">🔥</span>{site.name}
      </div>
      <p class="text-grass-100/90 text-sm leading-relaxed max-w-xs">{site.description}</p>
    </div>

    <div>
      <h3 class="font-semibold mb-3">页面导航</h3>
      <ul class="space-y-2 text-sm text-grass-100/90">
        {nav.map((item) => (
          <li><a href={item.href} class="hover:text-white transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-semibold mb-3">联系我们</h3>
      <p class="text-sm text-grass-100/90">{site.org}</p>
      <p class="text-sm text-grass-100/90 mt-1">邮箱:{site.email}</p>
    </div>
  </div>

  <div class="border-t border-grass-600">
    <div class="mx-auto max-w-6xl px-4 py-4 text-xs text-grass-100/70 text-center">
      © {site.year} {site.org} · 用 ❤️ 与代码搭建
    </div>
  </div>
</footer>
