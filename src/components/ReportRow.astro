---
// 营地报道:横向「左图右文」卡片(图在左,文字在右)
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; class?: string }
const { post, class: cls = '' } = Astro.props;
const { title, date, summary, cover, tags, author } = post.data;
const dateStr = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const placeholders = ['bg-csky-100', 'bg-camber-100', 'bg-cpink-100', 'bg-cgrass-100'];
const ph = placeholders[title.length % placeholders.length];
---

<a href={`/blog/${post.id}`} class={`sticker-card group grid overflow-hidden sm:grid-cols-[300px_1fr] ${cls}`}>
  <!-- 左:图 -->
  <div class={`relative min-h-48 overflow-hidden ${cover ? '' : ph}`}>
    {cover && (
      <img src={cover} alt={title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
    )}
    {tags[0] && (
      <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-ink shadow-sm backdrop-blur">
        #{tags[0]}
      </span>
    )}
  </div>
  <!-- 右:文字 -->
  <div class="flex flex-col p-6 md:p-7">
    <div class="flex flex-wrap gap-2">
      {tags.map((t) => (
        <span class="rounded-full border-[1.5px] border-ink/20 bg-card px-2.5 py-0.5 text-xs font-semibold text-ink/55">#{t}</span>
      ))}
    </div>
    <h3 class="mt-3 font-display text-xl leading-snug text-ink md:text-2xl">{title}</h3>
    <p class="mt-2.5 leading-relaxed text-ink/65 line-clamp-3">{summary}</p>
    <div class="mt-auto flex items-center justify-between pt-5 text-xs font-bold text-ink/40">
      <span>{author ? `✏️ ${author}` : ''}</span>
      <span class="inline-flex items-center gap-3">
        <time datetime={date.toISOString()}>{dateStr}</time>
        <span class="text-ink/30 transition-transform group-hover:translate-x-1">阅读 →</span>
      </span>
    </div>
  </div>
</a>
