---
// 班级入口卡:真实照片优先,无照片时用克制的实景感占位。
import type { SchoolClass } from '../data/classes';
import { ageGroups } from '../data/classes';
import { getCourse } from '../data/courses';
import { getMember } from '../data/team';
import { catColor } from './categoryColors';

interface Props {
  cls: SchoolClass;
  class?: string;
}
const { cls, class: clsName = '' } = Astro.props;
const head = getMember(cls.headTeacherId);
const group = ageGroups.find((g) => g.id === cls.ageGroupId);
---

<a href={`/classes/${cls.id}`} class={`group block overflow-hidden rounded-[1.25rem] border-2 border-ink/70 bg-card shadow-[5px_6px_0_rgba(61,44,30,0.14)] transition duration-200 hover:-translate-y-1 hover:shadow-[7px_9px_0_rgba(61,44,30,0.18)] ${clsName}`}>
  <div class="relative aspect-[16/10] overflow-hidden border-b-2 border-ink/60 bg-[#d9e6df]">
    {cls.coverImage ? (
      <img src={cls.coverImage} alt={`${cls.name}课堂照片`} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
    ) : (
      <div class="relative h-full w-full bg-[linear-gradient(180deg,#dce8e6_0%,#eef1e8_52%,#c7d1be_53%,#b8c5af_100%)]">
        <div class="absolute left-[8%] top-[14%] h-[42%] w-[44%] rounded-sm border-[6px] border-[#6d7d73] bg-[#25382f] shadow-[0_8px_18px_rgba(61,44,30,0.18)]"></div>
        <div class="absolute left-[12%] top-[22%] h-1.5 w-[30%] rounded-full bg-white/55"></div>
        <div class="absolute left-[12%] top-[33%] h-1.5 w-[22%] rounded-full bg-white/40"></div>
        <div class="absolute right-[13%] bottom-[16%] h-[30%] w-[23%] rounded-t-[999px] bg-[#8e6f54]/55"></div>
        <div class="absolute bottom-0 left-0 right-0 h-[16%] bg-[#8b785e]/28"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_22%,rgba(255,255,255,0.45),transparent_30%),linear-gradient(90deg,rgba(255,255,255,0.16),transparent)]"></div>
      </div>
    )}
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/65 to-transparent px-5 pb-4 pt-14">
      <span class="inline-flex rounded-full bg-card/95 px-3 py-1 text-xs font-bold text-ink shadow-sm">{group?.label}</span>
      <h3 class="mt-2 font-display text-3xl text-white drop-shadow-sm">{cls.name}</h3>
    </div>
  </div>

  <div class="p-5 md:p-6">
    <p class="min-h-[3.5rem] text-sm font-medium leading-relaxed text-ink/68">{cls.summary}</p>

    <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold text-ink/58">
      <span class="rounded-full bg-sun-200/70 px-3 py-1">带班老师 · {head?.name ?? '待定'}</span>
      <span class="rounded-full bg-grass-200/70 px-3 py-1">{cls.students.length} 名学生</span>
      <span class="rounded-full bg-csky-100 px-3 py-1">{cls.timetable.length} 节课/天</span>
    </div>

    <div class="mt-5 border-t-2 border-dashed border-ink/12 pt-4">
      <p class="mb-2 text-xs font-bold text-ink/40">一日课程</p>
      <div class="flex flex-wrap gap-2">
        {cls.timetable.map((t) => {
          const course = getCourse(t.courseId);
          const color = course ? catColor[course.category] : catColor['素养'];
          return (
            <span class={`rounded-full px-3 py-1 text-xs font-bold ${color.chip}`} title={`${t.time} ${course?.title ?? t.courseId}`}>
              {course?.title ?? t.courseId}
            </span>
          );
        })}
      </div>
    </div>
  </div>
</a>
