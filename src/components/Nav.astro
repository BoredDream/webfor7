---
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 bg-cream/85 backdrop-blur border-b border-grass-100">
  <nav class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-bold text-lg text-grass-700 shrink-0">
      <span class="text-2xl">🔥</span>
      <span>{site.name}</span>
    </a>

    <!-- 桌面导航 -->
    <ul class="hidden md:flex items-center gap-1 text-sm font-medium">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class={`px-3 py-2 rounded-full transition-colors ${
              isActive(item.href)
                ? 'bg-grass-100 text-grass-700'
                : 'text-gray-600 hover:bg-grass-50 hover:text-grass-700'
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- 移动端菜单按钮 -->
    <button
      id="navToggle"
      class="md:hidden p-2 rounded-lg text-gray-700 hover:bg-grass-50"
      aria-label="打开菜单"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </nav>

  <!-- 移动端下拉 -->
  <ul id="mobileMenu" class="hidden md:hidden border-t border-grass-100 bg-cream px-4 py-2">
    {nav.map((item) => (
      <li>
        <a
          href={item.href}
          class={`block px-3 py-3 rounded-lg ${
            isActive(item.href) ? 'text-grass-700 font-semibold' : 'text-gray-700'
          }`}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
  const setup = () => {
    const btn = document.getElementById('navToggle');
    const menu = document.getElementById('mobileMenu');
    btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  };
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
